# Copia este archivo a .env y ajusta lo que necesites.
# .env está en .gitignore: nunca se suben valores reales al repositorio.

# ---------- Base de datos ----------
POSTGRES_USER=docassist
POSTGRES_PASSWORD=docassist_dev
POSTGRES_DB=docassist
POSTGRES_PORT=5433

# ---------- Ollama ----------
OLLAMA_PORT=11434

# ---------- Proveedor de IA ----------
# El doble guion bajo es la forma en que .NET traduce una variable de entorno
# a una sección anidada de configuración: AI__Ollama__ChatModel -> AI:Ollama:ChatModel
AI__Provider=Ollama
AI__Ollama__Endpoint=http://localhost:11434
AI__Ollama__ChatModel=llama3.1:8b
AI__Ollama__EmbeddingModel=nomic-embed-text

# ---------- Proveedor en la nube (opcional) ----------
# Para cambiar de proveedor basta con estas variables, sin tocar código.
# AI__Provider=AzureOpenAI
# AI__AzureOpenAI__Endpoint=https://mi-recurso.openai.azure.com/
# AI__AzureOpenAI__ApiKey=
# AI__AzureOpenAI__ChatDeployment=gpt-4o-mini
# AI__AzureOpenAI__EmbeddingDeployment=text-embedding-3-small
